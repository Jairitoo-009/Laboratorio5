{
  "dependencies": {
    "express": "^4.22.3",
    "mocha": "^12.0.3",
    "socket.io": "^4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/integration/**/*.test.js"
    ]
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
